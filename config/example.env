## Project name
COMPOSE_PROJECT_NAME=saaster # Must be unique on docker host.

## Lucee settings
# Keep the Lucee image name for setup, then replace with your own later.
# Default: lucee/lucee:7.1.1.17-nginx
LUCEE_IMAGE=lucee/lucee
LUCEE_IMAGE_VERSION=7.1.1.17-nginx
LUCEE_CONTAINER_NAME=saaster_lucee # Must be unique on docker host.
LUCEE_PORT=8080 # Must be unique on docker host.
LUCEE_ADMIN_PASSWORD=defaultpass

## MySQL settings
MYSQL_PORT=3306 # Must be unique on docker host. In Lucee Admin please set to 3306.
MYSQL_ROOT_PASSWORD=defaultpass
MYSQL_CONTAINER_NAME=saaster_mysql_host # Will be the MySQL host/server.
MYSQL_DATABASE=saaster_db # Must be unique on docker host.
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password

## Flyway settings
# core: Migrations for Saaster core tables
# myapp: Migrations for your application's own tables
FLYWAY_DB_FOLDER=core # core or myapp
FLYWAY_MIGRATION_TYPE=migrate # migrate or repair
FLYWAY_CONTAINER_NAME=saaster_flyway # Must be unique on docker host.

## Optional services of compose.yml (production and staging)
# Comma-separated list of the profiles to start with "docker compose up".
# Production: COMPOSE_PROFILES=filebrowser - Staging: leave it empty (no file browser).
COMPOSE_PROFILES=filebrowser

## File Browser (production environment, profile "filebrowser")
FILEBROWSER_PORT=9999 # Must be unique on docker host.
FILEBROWSER_CONTAINER_NAME=saaster_dev_filebrowser # Must be unique on docker host.

## Inbucket settings (development environment)
INBUCKET_CONTAINER_NAME=saaster_inbucket # Will be used as the SMTP server in Lucee.
INBUCKET_SMTP_PORT=2500 # Must be unique on docker host. In Lucee Admin please set to 2500.
INBUCKET_WEB_PORT=9000 # Must be unique on docker host.
INBUCKET_POP3_PORT=1100 # Must be unique on docker host.


## Borg backup settings (Linux server; disabled until configured)
# production or staging. The isolated test harness uses a guarded test mode.
BACKUP_ENV=

# Leave BORG_REPO empty to derive an SSH repository from the server settings.
# For local backups, use an absolute directory instead.
BORG_REPO=
BORG_REMOTE_PATH=borg-1.2
# Store the passphrase outside this checkout and retain a separate recovery copy.
BORG_PASSPHRASE_FILE=
BORG_KEEP_DAILY=7
BORG_KEEP_WEEKLY=4
BORG_KEEP_MONTHLY=12
BORG_COMPRESSION=lz4
BORG_WORK_DIR=/backup

REMOTE_BACKUP_PATH=saaster
SERVER_USER=
SERVER_HOST=
SERVER_PORT=23
SSH_KEY_PATH=
